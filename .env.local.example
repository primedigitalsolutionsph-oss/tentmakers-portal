# Site
# Production canonical URL used for metadata. Set this per deployment environment.
NEXT_PUBLIC_SITE_URL=https://tentmakers.primedigitalsolutions.ph

# Hostinger MySQL (primary database + auth)
# hPanel → Databases → create DB + user, then paste the connection string.
# Example: mysql://u123456789_tentmakers:PASSWORD@193.203.1.2:3306/u123456789_tentmakers
DATABASE_URL=mysql://user:password@host:3306/tentmakers

# NextAuth (required when DATABASE_URL is set)
# Generate: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=your-auth-secret
# Production canonical auth URL (required in production so callbacks resolve
# to the domain instead of localhost).
NEXTAUTH_URL=https://tentmakers.primedigitalsolutions.ph
# Google OAuth (redirect URI: https://<domain>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Demo mode (local development only — never enable in staging or production).
NEXT_PUBLIC_ALLOW_DEMO_AUTH=false

# Contact delivery via Resend
RESEND_API_KEY=your-resend-api-key
CONTACT_FROM_EMAIL=primadigitalsolutions.ph@gmail.com
CONTACT_TO_EMAIL=primadigitalsolutions.ph@gmail.com
