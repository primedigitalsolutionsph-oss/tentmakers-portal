# Site
# Production canonical URL used for metadata. Set this per deployment environment.
NEXT_PUBLIC_SITE_URL=https://tentmakers.ph

# Supabase (primary until Hostinger cutover)
# Get these from https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# @supabase/server (server-side clients, JWT verification)
# Get these from https://app.supabase.com → Project Settings → API
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Hostinger MySQL (optional until cutover; additive — app runs on Supabase when unset)
# hPanel → Databases → create DB + user, then paste the connection string.
# Example: mysql://u123456789_tentmakers:PASSWORD@193.203.1.2:3306/u123456789_tentmakers
DATABASE_URL=mysql://user:password@host:3306/tentmakers

# Auth.js (required only when DATABASE_URL is set)
# Generate: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=your-auth-secret
# Google OAuth (same Client ID/Secret can feed Supabase now and Auth.js later)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Demo mode (local development only — never enable in staging or production).
# When Supabase is unconfigured, true allows dashboard access without login.
NEXT_PUBLIC_ALLOW_DEMO_AUTH=false

# Contact delivery via Resend
# CONTACT_TO_EMAIL defaults to primadigitalsolutions.ph@gmail.com.
RESEND_API_KEY=your-resend-api-key
CONTACT_FROM_EMAIL=primadigitalsolutions.ph@gmail.com
CONTACT_TO_EMAIL=primadigitalsolutions.ph@gmail.com

# Hero 3D scene (Spline). Publish a scene in Spline → Export → Viewer,
# paste the scene URL here. Empty = SVG ecosystem diagram fallback.
# NEXT_PUBLIC_SPLINE_SCENE_URL=https://prod.spline.design/xxxx/scene.splinecode
